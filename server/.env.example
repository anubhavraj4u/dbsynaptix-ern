# Server
PORT=8000
FRONTEND_URL=http://localhost:5173

# The app's own Postgres database (stores the semantic index).
# Create an empty database called dbsynaptix first.
APP_DATABASE_URL=postgres://postgres:your_password@localhost:5432/dbsynaptix

# Gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Default PostgreSQL (only used by helper scripts, same as before)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_password
